extends ../layout.pug
include ../mixins/globalmanagenav.pug
include ../mixins/post.pug

block head
	title #{__('Approval')}

block content
	h1.board-title #{__('Approval')}
	br
	.wrapbar
		+globalmanagenav('approvals')
		if page === 1 && !ip && !account
			.jsonly#livetext(data-view-raw-ip=(viewRawIp?'true':'false') data-view-raw-account=(viewRawAccount?'true':'false') data-room=`globalmanage-approval-${viewRawIp === true ? 'raw' : 'hashed'}`)
				.dot#livecolor
				|  #{__('Connecting...')} 
				input.postform-style.ml-5.di#updatepostsbutton(type='button' value=__('Update'))
	form(action=`/forms/global/actions` method='POST' enctype='application/x-www-form-urlencoded')
		input(type='hidden' name='_csrf' value=csrf)
		.pages.mv-5
			include ../includes/pages.pug
		if posts.length === 0
			hr(size=1)
			p#no-files-pending #{__('No files pending approval.')}
		else
			hr(size=1)
			//- if ip
			//- 	h4.no-m-p #{__('Reports against or by ip %s', ip)}
			//- 	hr(size=1)
			for post in posts
				.thread
					+post(post, false, false, true, false, false, true)
				hr(size=1)
			.pages.mv-5
				include ../includes/pages.pug
			include ../includes/actionfooter_globalmanage.pug
